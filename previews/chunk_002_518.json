        "Heading": "\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438 \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0441\u0430\u0439\u0442\u043e\u0432, \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u0432 - \u041a\u0438\u0431\u0435\u0440\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430",
        "Abstract": "\u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u041a\u0438\u0431\u0435\u0440\u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430: \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u043e\u0432, \u0440\u0435\u043a\u043b\u0430\u043c\u043d\u043e\u0435 \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435, \u0421\u0415\u041e \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f. \u041a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0435 \u0443\u0441\u043b\u0443\u0433\u0438 \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u0431\u0438\u0437\u043d\u0435\u0441\u0430. \u0420\u0435\u0448\u0430\u0435\u043c \u0441\u043b\u043e\u0436\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0441 1999 \u0433\u043e\u0434\u0430.",
