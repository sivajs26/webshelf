        "Abstract": "\u0627\u062e\u0628\u0627\u0631 \u0639\u0631\u0628\u064a\u0629 \u0639\u0644\u0649 \u0645\u062f\u0627\u0631 \u0627\u0644\u0633\u0627\u0639\u0629 \u0645\u0646 \u0628\u0631\u0633 \u0628\u064a PRESSBEE . \u064a\u062a\u0642\u0644 \u0627\u0644\u064a\u0643 \u0627\u062e\u0628\u0627\u0631 \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0627\u0648\u0633\u0637 \u0627\u0644\u0627\u0646 \u0639\u0627\u062c\u0644 \u0648\u062e\u0644\u0627\u0644 24 \u0633\u0627\u0639\u0629 . \u0635\u062d\u0627\u0641\u0629 \u0646\u062a 24 \u0639\u0631\u0628\u064a\u0629 \u0639\u0628\u0631 \u062a\u0637\u0628\u064a\u0642 \u0628\u0631\u0633 \u0628\u064a \u0648 \u0641\u064a\u062f\u064a\u0648 \u0645\u0628\u0627\u0634\u0631 \u0645\u0646 \u0627\u0644\u0635\u062d\u0641 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0645\u0628\u0627\u0634\u0631 \u060c \u0627\u062e\u0628\u0627\u0631 \u0627\u0644\u0645\u0634\u0647\u062f \u0627\u0644\u0633\u064a\u0627\u0633\u064a \u0627\u062e\u0628\u0627\u0631 \u0645\u0635\u0631 \u0627\u0644\u064a\u0648\u0645 \u0648 \u0627\u062e\u0628\u0627\u0631 \u0627\u0644\u062e\u0644\u064a\u062c \u0648 \u0627\u0644\u064a\u0645\u0646 \u0648 \u0627\u0644\u062c\u0632\u0627\u0626\u0631 \u0648 \u0627\u0644\u0633\u0648\u062f\u0627\u0646 \u0648 \u0627\u0644\u0639\u0631\u0627\u0642 \u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u0635\u062d\u0627\u0641\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 ",
